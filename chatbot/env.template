# Copy this file to .env and fill in your API keys
# cp env.template .env

# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── GCP / Gemini — ADC-based auth (no API key required) ───────────────────────
# Priority 1 — Impersonation (production): set to shared SA email
#   Requires: gcloud auth application-default login (or metadata server ADC)
#   Requires: roles/iam.serviceAccountTokenCreator on the caller identity
GCP_IMPERSONATE_SA=shared-sa@your-project.iam.gserviceaccount.com

# Priority 2 — Key file (local dev fallback): path to service account JSON
#   Also used by the BigQuery connector.
#   Leave blank to fall through to Priority 3.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa-key.json

# Priority 3 — Ambient ADC (last resort, logs a WARNING):
#   Run: gcloud auth application-default login
#   No env var needed; GOOGLE_CLOUD_PROJECT required for Vertex AI / ADK.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

LLM_PROVIDER=anthropic

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── App Database (chat history) ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot.db

# ── Redis (DataFrame store + clarification state) ─────────────────────────────
# Docker Compose: redis://redis:6379/0
# Local dev:      redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# ── BigQuery (Application Default Credentials) ────────────────────────────────
# Set GOOGLE_APPLICATION_CREDENTIALS to the path of your service account JSON.
# Mount the file into the container and set the path here.
# Example docker-compose volume: - ./sa-key.json:/secrets/sa-key.json
BIGQUERY_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa-key.json

# ── MSSQL (SQL Server via pyodbc) ─────────────────────────────────────────────
MSSQL_SERVER=your-server.database.windows.net
MSSQL_DATABASE=your-database
MSSQL_USERNAME=your-username
MSSQL_PASSWORD=your-password
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# ── Skills directory ──────────────────────────────────────────────────────────
# Path to the YAML skill definitions loaded by SkillRegistry.
# Default: ./app/skills (relative to the backend working directory).
# In Docker: mapped as ./backend/app/skills:/app/app/skills:ro by docker-compose.
# SKILLS_DIR=./app/skills

# ── CORS / WebSocket ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
WS_HEARTBEAT_INTERVAL=25

# ── App ───────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
DEBUG=false
